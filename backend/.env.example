APP_NAME=Smart Resume Platform API
ENV=development
API_V1_PREFIX=/api/v1

# Change this to your VM MySQL address before running the backend.
DATABASE_URL=mysql+pymysql://resume_user:resume_password@192.168.56.10:3306/smart_resume_platform?charset=utf8mb4
DB_CONNECT_TIMEOUT=60
DB_READ_TIMEOUT=60
DB_WRITE_TIMEOUT=60
DB_POOL_RECYCLE=1800
DB_SSL=true

JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MAX_PDF_SIZE_MB=10
UPLOAD_DIR=uploads/pdf
GENERATED_LATEX_DIR=generated/latex

# Keep true until you are ready to call the real LLM.
LLM_MOCK=true
CLIKEY=
CLIBASEURL=http://159.65.223.0:18317/v1
# openai_compatible means POST {CLIBASEURL}/chat/completions.
# Use direct only for custom gateways that accept chat payloads at CLIBASEURL itself.
LLM_ENDPOINT_MODE=openai_compatible
LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
